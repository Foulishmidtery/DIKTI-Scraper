{
  "name": "pddikti-dashboard-frontend",
  "description": "Desktop scraper dan analitik PDDIKTI.",
  "author": "Kementerian Keuangan",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "main": "electron-dist/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node electron/build-main.cjs",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "electron:dev": "npm run build && electron .",
    "electron:pack": "node electron/prepare-icon.cjs && node electron/prepare-release.cjs && electron-builder --win portable",
    "ui:install": "powershell -ExecutionPolicy Bypass -File scripts/install-original-ui.ps1"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/windows-sign": "^1.2.2",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "42.7.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "id.go.kemenkeu.pddikti-scraper",
    "productName": "PDDIKTI Scraper",
    "artifactName": "PDDIKTI-Scraper-Portable-${version}.${ext}",
    "compression": "normal",
    "asar": true,
    "disableAsarIntegrity": true,
    "afterPack": "electron/after-pack.cjs",
    "afterAllArtifactBuild": "electron/after-artifacts.cjs",
    "directories": {
      "output": "../release"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend-dist/pddikti-backend",
        "to": "backend"
      }
    ],
    "win": {
      "icon": "electron/assets/kneks-icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    },
    "portable": {
      "requestExecutionLevel": "user",
      "splashImage": "electron/assets/portable-splash.bmp"
    }
  }
}
