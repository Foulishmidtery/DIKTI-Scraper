# Server-side Vercel env only. Jangan gunakan prefix VITE_ untuk secret.
DATABASE_URL=postgresql://pddikti_gateway:CHANGE_ME@HOST:5432/pddikti?sslmode=verify-full
# Opsional untuk CA privat, gunakan isi PEM dengan newline sebagai \n.
POSTGRES_CA_CERT=

# Buat: 32+ random bytes. Jangan pernah masukkan ke Electron/repository.
SESSION_MASTER_KEY=
# SHA-256 hex dari kode aktivasi yang diberikan admin kepada operator.
DESKTOP_ACTIVATION_CODE_SHA256=
ALLOWED_DESKTOP_VERSION=2.0.0
SESSION_TTL_SECONDS=2700
REQUEST_CLOCK_SKEW_SECONDS=60
MAX_REQUEST_BYTES=1048576
SESSION_RATE_LIMIT_MAX=10
GATEWAY_RATE_LIMIT_MAX=180
