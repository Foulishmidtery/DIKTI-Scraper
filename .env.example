# DEVELOPMENT ONLY. File ini tidak ikut ke paket Electron production.
# PostgreSQL lokal; DATABASE_URL diprioritaskan jika diisi.
DATABASE_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=pddikti
POSTGRES_USER=pddikti_app
POSTGRES_PASSWORD=CHANGE_ME_NOW
DATABASE_POOL_SIZE=5

# Flask API
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0
PDDIKTI_AUTH_KEY=
PDDIKTI_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PDDIKTI_OUTPUT_DIR=

# Development gateway opsional. Production URL ditanam sebagai public trust anchor
# pada frontend/electron/runtime-config.cjs; tidak ada credential DB di client.
PDDIKTI_SECURE_GATEWAY=0
PDDIKTI_GATEWAY_URL=http://127.0.0.1:3000
PDDIKTI_ALLOW_INSECURE_GATEWAY=1

# Port container (opsional)
POSTGRES_PUBLIC_PORT=5432
BACKEND_PUBLIC_PORT=5000
FRONTEND_PUBLIC_PORT=8080
